package vn.gov.cic.study.drools.rules

import vn.gov.cic.study.drools.domain.LoanApplicationFact;

rule "Reject high risk applicant under 25 years old"
    salience 30
when
    $loan : LoanApplicationFact(age < 25)
then
    $loan.reject("HIGH_RISK_AGE_TOO_LOW: applicant must be at least 25 years old");
end

rule "Reject high risk bad debt"
    salience 20
when
    $loan : LoanApplicationFact(hasExistingBadDebt == true)
then
    $loan.reject("HIGH_RISK_BAD_DEBT: applicant has existing bad debt");
end

rule "Reject high risk low credit score"
    salience 10
when
    $loan : LoanApplicationFact(creditScore < 700)
then
    $loan.reject("HIGH_RISK_LOW_CREDIT_SCORE: credit score must be at least 700");
end

rule "Reject high risk loan amount over conservative affordability threshold"
when
    $loan : LoanApplicationFact(loanAmount > highRiskMaxAffordableLoan)
then
    $loan.reject("HIGH_RISK_LOAN_TOO_HIGH: loan amount is greater than 12 months of income");
end
